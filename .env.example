# Copy to .env (never commit .env). scripts/setup_postgres.* writes this file for you.
# PostgreSQL (temporary credentials created by db/setup_postgres.sql; the password expires - rotate it)
SCOS_DATABASE_URL=postgresql+psycopg://scos_app:CHANGE_ME_TEMP_PASSWORD@localhost:5432/subcontract_os
# Run Alembic migrations automatically at start-up (1) or manually with `python -m app.cli migrate` (0)
SCOS_AUTO_MIGRATE=1
# Key for encrypting stored LLM API keys (generate: python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())")
# SCOS_SECRET_KEY=
# Sessions
SCOS_SESSION_HOURS=8
SCOS_COOKIE_SECURE=0
# Never enable in production: allows the X-User development header
SCOS_ALLOW_DEV_AUTH=0
# Address users open in the browser; used for the sign-in provider redirect URI
SCOS_PUBLIC_BASE_URL=http://localhost:8000
